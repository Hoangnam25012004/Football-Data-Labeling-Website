# Sample / large match data — not part of the website
*.xlsx
~$*

# Rendered video — the 3-minute client film is 17 MB and rebuilt from takes
*.mp4

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Build output (generated by CI)
_site/

# npm dependencies (restored with `npm install`; see worker/package-lock.json)
node_modules/

# Local browser profile used by the demo recorder (~190 MB of Chrome state)
apps/portal/chrome-profile/

# Client deliverables: rendered match reports and marketing material stay on
# disk, not in git (the one Hanley Town sample report is tracked on purpose)
deliverables/match-reports/*.pdf
!deliverables/match-reports/Hanley_Town_vs_Gornal_Athletic_Match_Report.pdf
deliverables/marketing/

# Scratch API responses (can hold session tokens)
resp.json
